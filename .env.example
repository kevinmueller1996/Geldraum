# Market-launch authentication. Keep real values in hosted secrets only.
AUTH_REQUIRE_EMAIL_VERIFICATION=1
AUTH_PUBLIC_ORIGIN=https://njora.de
AUTH_EMAIL_FROM=
RESEND_API_KEY=

# Optional direct Vercel-to-D1 access. If none are set, the configured backend proxy is used.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
GELDRAUM_BACKEND_ORIGIN=https://klarbudget-kevin-2026.alpher5.chatgpt.site

# Existing GDPR admin surface.
GELDRAUM_ADMIN_TOKEN=
GELDRAUM_ADMIN_USER_ID=

# Enable only after verified provider purchases, renewal and cancellation.
NJORA_BILLING_ENABLED=false
NJORA_STRIPE_PRICE=
NJORA_STRIPE_SECRET=
NJORA_APPLE_KEY_ID=
NJORA_APPLE_ISSUER=
NJORA_APPLE_PRIVATE_KEY=
NJORA_APPLE_ENVIRONMENT=Production
